# TEST-ONLY credentials for the throwaway database servers of compose.yaml.
# They are deliberately fake, only valid inside these containers, and must
# never be used anywhere else. This file is the one place they are defined:
# the servers read it via env_file, ./run.sh reads it to build the DSN.

# MariaDB and MySQL (the MariaDB image also reads the MYSQL_* names)
MYSQL_DATABASE=filefly
MYSQL_USER=filefly
MYSQL_PASSWORD=not-a-real-password
MYSQL_ROOT_PASSWORD=not-a-real-root-password

# PostgreSQL
POSTGRES_DB=filefly
POSTGRES_USER=filefly
POSTGRES_PASSWORD=not-a-real-password
