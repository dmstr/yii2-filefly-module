{
    "name": "dmstr/yii2-filefly-module",
    "description": "FlySystem API for Filemanager",
    "type": "yii2-extension",
    "keywords": ["yii2","extension"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Tobias Munk",
            "email": "tobias@diemeisterei.de"
        },
        {
            "name": "Christopher Stebe",
            "email": "c.stebe@herzogkommunikation.de"
        }
    ],
    "scripts": {
        "phpstan": "vendor/bin/phpstan"
    },
    "require": {
        "php": "^8.1",
        "yiisoft/yii2": "~2.0.13",
        "creocoder/yii2-flysystem": "^2.0",
        "league/flysystem": "^3.35.3",
        "league/flysystem-local": "^3.35.3",
        "league/mime-type-detection": "^1.17",
        "dmstr/yii2-active-record-permissions": "^1.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "enshrined/svg-sanitize": "^1.1",
        "dmstr/yii2-web": "^1.1",
        "league/flysystem-aws-s3-v3": "^3",
        "league/flysystem-ftp": "^3",
        "phpstan/phpstan": "^2.3",
        "mspirkov/yii2-phpstan": "^0.17",
        "dmstr/yii2-helpers": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "hrzg\\filefly\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "hrzg\\filefly\\tests\\": "tests/"
        }
    },
    "suggest": {
        "dmstr/yii2-filemanager-widgets": "Useful widget for working with files via the filefly api",
        "enshrined/svg-sanitize": "Required for ContentValidator::$sanitizeSvg (^1.1)",
        "league/flysystem-aws-s3-v3": "S3 adapter for creocoder\\flysystem\\AwsS3Filesystem (^3.0)",
        "league/flysystem-ftp": "FTP adapter for creocoder\\flysystem\\FtpFilesystem (^3.0)",
        "league/flysystem-sftp-v3": "SFTP adapter for creocoder\\flysystem\\SftpFilesystem (^3.0)",
        "league/flysystem-webdav": "WebDAV adapter for creocoder\\flysystem\\WebDAVFilesystem (^3.0)"
    },
    "repositories": [{
        "name": "asset-packagist",
        "type": "composer",
        "url": "https://asset-packagist.org"
    }],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
