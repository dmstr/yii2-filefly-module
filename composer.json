{
    "name": "dmstr/yii2-filefly-module",
    "description": "FlySystem API for Filemanager",
    "type": "yii2-extension",
    "keywords": ["yii2","extension"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Tobias Munk",
            "email": "tobias@diemeisterei.de"
        },
        {
            "name": "Christopher Stebe",
            "email": "c.stebe@herzogkommunikation.de"
        }
    ],
    "require": {
        "yiisoft/yii2": "~2.0.13",
        "creocoder/yii2-flysystem": "^1.0.0",
        "dmstr/yii2-active-record-permissions": "^1.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "enshrined/svg-sanitize": "^1.1",
        "dmstr/yii2-web": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "hrzg\\filefly\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "hrzg\\filefly\\tests\\": "tests/"
        }
    },
    "suggest": {
        "dmstr/yii2-filemanager-widgets": "Useful widget for working with files via the filefly api",
        "enshrined/svg-sanitize": "Required for ContentValidator::$sanitizeSvg (^1.1)",
        "league/flysystem-sftp": "SFTP adapter (~1.0)",
        "league/flysystem-webdav": "WebDAV adapter (~1.0)"
    },
    "repositories": [{
        "name": "asset-packagist",
        "type": "composer",
        "url": "https://asset-packagist.org"
    }],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "audit": {
            "ignore": {
                "PKSA-w9tt-7782-78jx": "Flysystem 1.x has no fixed release; dev-only until the Flysystem 3 migration removes it"
            }
        }
    }
}
